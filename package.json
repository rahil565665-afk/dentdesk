{
  "name": "dentdesk-receptionist-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "PORT=3001 tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/server/index.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@pipecat-ai/client-js": "^1.15.0",
    "@pipecat-ai/websocket-transport": "^1.8.1",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
