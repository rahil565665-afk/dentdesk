# Local development only. Copy this file to .env; never commit or upload .env.
# In hosted production, set secrets through Render's protected environment settings.

# Dashboard passcode/session. Production must use a random 32-byte key (64 hex chars).
DASHBOARD_ADMIN_PASSCODE=
DASHBOARD_SESSION_SECRET=
APP_PUBLIC_URL=http://localhost:3000

# Render control plane. The repository must be private and linked to Render's Git provider.
RENDER_API_KEY=
RENDER_REPO_URL=https://github.com/your-org/your-private-repo.git
RENDER_BRANCH=main
RENDER_REGION=singapore
# Optional when the Render key can access multiple workspaces; otherwise detected read-only.
RENDER_OWNER_ID=

# Central Supabase project: service-role secret is server-only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional server-side defaults for the first demo clinic. Values entered in the UI override these.
# Per-clinic secrets are written to that Render agent service, never returned to the browser/DB.
GEMINI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CALCOM_API_KEY=

# Local-only appointment selector fallbacks for agent/.env. Production clinic settings live in Supabase.
CALCOM_EVENT_TYPE_ID=
CALCOM_EVENT_TYPE_SLUG=
CALCOM_USERNAME=
CALCOM_TEAM_SLUG=
LOCAL_DEV_FALLBACK=false

# Do not set TWILIO_ENABLED=true; Twilio is not connected by this demo.
# Twilio credentials, if entered, are stored in the Render service only and remain unused.

API_PORT=3001
PORT=3000
